---
// src/pages/servicios.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CardServicio from '../components/CardServicio.astro';
import { getServices } from '../lib/queries';
import { urlFor } from '../lib/sanity';

// Consultar servicios reales desde Sanity
const sanityServices = await getServices();

const fallbackServices = [
  {
    _id: '1',
    title: 'Protección de Instalaciones',
    slug: { current: 'proteccion-de-instalaciones' },
    description: 'Vigilancia física especializada con oficiales capacitados y protocolos avanzados para resguardar plantas, oficinas y complejos residenciales.',
    iconSymbol: '🛡️'
  },
  {
    _id: '2',
    title: 'Protección Ejecutiva VIP',
    slug: { current: 'proteccion-ejecutiva' },
    description: 'Escoltas altamente entrenados y transporte blindado para la protección integral de altos directivos, personalidades y sus familias.',
    iconSymbol: '👔'
  },
  {
    _id: '3',
    title: 'Seguridad Electrónica y CCTV',
    slug: { current: 'seguridad-electronica' },
    description: 'Sistemas inteligentes de videovigilancia con analítica de inteligencia artificial, control de acceso biométrico y alarmas perimetrales.',
    iconSymbol: '📹'
  },
  {
    _id: '4',
    title: 'Control de Pérdidas e Investigaciones',
    slug: { current: 'control-de-perdidas' },
    description: 'Auditorías de procesos internos, investigaciones corporativas y prevención de fraudes o mermas operativas.',
    iconSymbol: '🔎'
  },
  {
    _id: '5',
    title: 'Seguridad Industrial y Salud Ocupacional',
    slug: { current: 'seguridad-industrial' },
    description: 'Planes de prevención de accidentes, cumplimiento de normativas de trabajo y protocolos de emergencia industrial.',
    iconSymbol: '⛑️'
  },
  {
    _id: '6',
    title: 'Consultoría en Gestión de Riesgos',
    slug: { current: 'consultoria-de-riesgos' },
    description: 'Evaluación y diagnóstico de vulnerabilidades estratégicas para diseñar planes de seguridad a la medida de tu organización.',
    iconSymbol: '📊'
  }
];

const services = (sanityServices && sanityServices.length > 0)
  ? sanityServices.map((s: any) => ({
      _id: s._id,
      title: s.title,
      slug: s.slug?.current || '#',
      description: s.description || 'Solución integral de seguridad adaptada a tus requerimientos.',
      imageUrl: s.icon ? urlFor(s.icon)?.width(800).height(500).url() : null
    }))
  : fallbackServices.map((s: any) => ({
      _id: s._id,
      title: s.title,
      slug: s.slug.current,
      description: s.description,
      icon: s.iconSymbol
    }));
---

<BaseLayout title="Servicios Especializados de Seguridad - SPS Risk">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    
    <!-- Encabezado Principal de Servicios -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold text-sps-blue uppercase tracking-widest bg-sps-light-blue px-4 py-1.5 rounded-full inline-block mb-4">
        Portafolio Institucional
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-sps-navy tracking-tight mb-6">
        Nuestros Servicios
      </h1>
      <p class="text-lg text-gray-600 font-light leading-relaxed">
        Soluciones integrales de protección corporativa, tecnología electrónica de vanguardia y consultoría de riesgos estratégicos.
      </p>
    </div>

    <!-- Grid de Servicios (3 columnas) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {services.map((service: any) => (
        <CardServicio 
          title={service.title} 
          description={service.description}
          slug={service.slug}
          imageUrl={service.imageUrl}
          icon={service.icon}
        />
      ))}
    </div>

    <!-- CTA de Asesoría Gratuita -->
    <div class="bg-gradient-to-r from-sps-navy to-sps-blue text-white rounded-3xl p-10 lg:p-16 text-center max-w-4xl mx-auto shadow-2xl">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">¿Necesitas una evaluación de seguridad personalizada?</h2>
      <p class="text-gray-200 text-base sm:text-lg font-light mb-8 max-w-2xl mx-auto">
        Nuestros analistas y consultores están disponibles para auditar tus instalaciones y diseñar una propuesta a la medida de tu empresa.
      </p>
      <a href="/contacto" class="inline-block px-8 py-4 bg-sps-yellow text-sps-navy font-bold rounded-full hover:bg-white transition-colors shadow-lg text-sm">
        Solicitar evaluación sin costo
      </a>
    </div>

  </div>
</BaseLayout>
