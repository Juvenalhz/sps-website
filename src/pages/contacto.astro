---
// src/pages/contacto.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContactPage, getSiteSettings, getServices } from "../lib/queries";

const contactData = await getContactPage();
const siteSettings = await getSiteSettings();
const sanityServices = await getServices();

const badgeText = contactData?.badgeText || 'Atención Personalizada 24/7';
const pageTitle = contactData?.title || 'Contáctanos';
const pageSubtitle = contactData?.subtitle || 'Estamos listos para evaluar los riesgos de tu empresa y diseñar una solución de seguridad integral a la medida de tus necesidades.';

const sectionTitle = contactData?.sectionTitle || 'Estamos donde nos necesites';
const sectionDescription = contactData?.sectionDescription || 'Comunícate con nuestro equipo multidisciplinario. Ofrecemos respuesta inmediata y asesoría experta en todo el territorio nacional.';

const headquartersTitle = contactData?.headquartersTitle || 'Sede Principal (Caracas)';
const headquartersAddress = contactData?.headquartersAddress || siteSettings?.address || 'Av. Francisco de Miranda, Edif. EASO, Piso 3, Ofc. 3JK, El Rosal, Caracas.';

const phoneTitle = contactData?.phoneTitle || 'Teléfonos de Contacto';
const phoneMain = contactData?.phoneMain || siteSettings?.contactPhone || '+58 (212) 952.52.42';
const phoneEmergency = contactData?.phoneEmergency || 'Línea de Emergencia 24/7 disponible para clientes';
const whatsappNumber = contactData?.whatsappNumber;

const emailTitle = contactData?.emailTitle || 'Correo Electrónico';
const emailMain = contactData?.emailMain || siteSettings?.contactEmail || 'contacto@sps-seguridad.com';

const formTitle = contactData?.formTitle || 'Solicitar Evaluación o Cotización';
const formSubtitle = contactData?.formSubtitle || 'Completa el siguiente formulario y un consultor especialista en seguridad se pondrá en contacto contigo en breve.';
const formSubmitButtonText = contactData?.formSubmitButtonText || 'Enviar Solicitud';
const formSuccessText = contactData?.formSuccessText || 'Gracias por tu mensaje. Te contactaremos pronto.';
---

<BaseLayout title={pageTitle}>
  <!-- Hero / Encabezado de Contacto -->
  <section class="bg-gradient-to-r from-sps-navy via-[#073067] to-sps-blue text-white py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-sps-yellow/20 text-sps-yellow text-xs sm:text-sm font-bold tracking-wider uppercase mb-4">
        {badgeText}
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-oswald font-bold uppercase tracking-tight mb-6">
        {pageTitle}
      </h1>
      <p class="max-w-2xl mx-auto text-gray-200 text-base sm:text-lg font-light leading-relaxed">
        {pageSubtitle}
      </p>
    </div>
  </section>

  <!-- Sección Principal: Datos de Contacto y Formulario -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-stretch">
      
      <!-- Lado Izquierdo: Tarjetas de Información de Contacto -->
      <div class="lg:col-span-5 flex flex-col justify-between p-8 sm:p-12 bg-gray-50/50 rounded-3xl border border-gray-100">
        <div>
          <h2 class="text-2xl sm:text-3xl font-oswald font-bold text-sps-navy uppercase mb-2">
            {sectionTitle}
          </h2>
          <p class="text-gray-500 text-sm mb-8">
            {sectionDescription}
          </p>

          <div class="space-y-6">
            <!-- Tarjeta 1: Dirección Sede Principal -->
            <div class="flex items-start gap-5 p-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-11 h-11 rounded-xl bg-sps-blue/10 text-sps-blue flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-base mb-0.5">{headquartersTitle}</h3>
                <p class="text-gray-500 text-xs leading-relaxed whitespace-pre-line">
                  {headquartersAddress}
                </p>
              </div>
            </div>

            <!-- Tarjeta 2: Teléfonos -->
            <div class="flex items-start gap-5 p-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-11 h-11 rounded-xl bg-sps-blue/10 text-sps-blue flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.54-4.24-7.136-7.136l1.292-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-base mb-0.5">{phoneTitle}</h3>
                <p class="text-gray-500 text-xs leading-relaxed">
                  <strong class="text-sps-blue">{phoneMain}</strong><br/>
                  {phoneEmergency}
                </p>
                {whatsappNumber && (
                  <a 
                    href={`https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-600 hover:text-emerald-700 mt-2 bg-emerald-50 px-2.5 py-1 rounded-lg transition-colors"
                  >
                    <span>💬 Contactar por WhatsApp</span>
                  </a>
                )}
              </div>
            </div>

            <!-- Tarjeta 3: Correo -->
            <div class="flex items-start gap-5 p-5 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
              <div class="w-11 h-11 rounded-xl bg-sps-blue/10 text-sps-blue flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-base mb-0.5">{emailTitle}</h3>
                <p class="text-gray-500 text-xs leading-relaxed">
                  <a href={`mailto:${emailMain}`} class="hover:text-sps-blue transition-colors font-semibold">{emailMain}</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Lado Derecho: Formulario de Contacto (Dinámico) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-xl">
        <h3 class="text-2xl sm:text-3xl font-oswald font-bold text-sps-navy uppercase mb-2">
          {formTitle}
        </h3>
        <p class="text-gray-500 text-sm mb-8">
          {formSubtitle}
        </p>

        <form class="space-y-6" data-success-msg={formSuccessText} onsubmit={`event.preventDefault(); alert(this.getAttribute('data-success-msg'));`}>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Nombre -->
            <div>
              <label for="nombre" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Nombre Completo *
              </label>
              <input 
                type="text" 
                id="nombre" 
                required 
                placeholder="Ej. Carlos Mendoza" 
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800"
              />
            </div>

            <!-- Empresa -->
            <div>
              <label for="empresa" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Empresa / Organización
              </label>
              <input 
                type="text" 
                id="empresa" 
                placeholder="Nombre de tu empresa" 
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Correo -->
            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Correo Electrónico *
              </label>
              <input 
                type="email" 
                id="email" 
                required 
                placeholder="carlos@empresa.com" 
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800"
              />
            </div>

            <!-- Teléfono -->
            <div>
              <label for="telefono" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
                Teléfono de Contacto *
              </label>
              <input 
                type="tel" 
                id="telefono" 
                required 
                placeholder="+58 414 0000000" 
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800"
              />
            </div>
          </div>

          <!-- Servicio de Interés (Alimentado dinámicamente desde Sanity) -->
          <div>
            <label for="servicio" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
              Servicio de Interés *
            </label>
            <select 
              id="servicio" 
              required 
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800 bg-white"
            >
              <option value="">Selecciona un servicio</option>
              {sanityServices && sanityServices.length > 0 ? (
                sanityServices.map((svc: any) => (
                  <option value={svc.slug?.current || svc.title}>{svc.title}</option>
                ))
              ) : (
                <>
                  <option value="cctv">CCTV Inteligente y Videovigilancia</option>
                  <option value="proteccion">Protección Ejecutiva VIP</option>
                  <option value="acceso">Control de Acceso</option>
                  <option value="industrial">Seguridad Industrial y Prevención</option>
                  <option value="ciberseguridad">Ciberseguridad Corporativa</option>
                  <option value="evaluacion">Evaluación Integral de Riesgos</option>
                </>
              )}
            </select>
          </div>

          <!-- Mensaje -->
          <div>
            <label for="mensaje" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">
              Detalles de tu solicitud *
            </label>
            <textarea 
              id="mensaje" 
              rows="4" 
              required 
              placeholder="Cuéntanos brevemente cuáles son tus requerimientos o dudas de seguridad..." 
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-sps-blue focus:ring-2 focus:ring-sps-blue/20 outline-none transition-all text-sm text-gray-800 resize-none"
            ></textarea>
          </div>

          <!-- Botón de Enviar (Dinámico) -->
          <button 
            type="submit" 
            class="w-full bg-sps-blue hover:bg-sps-navy text-white font-bold py-4 rounded-xl shadow-lg transition-all text-base tracking-wide uppercase cursor-pointer"
          >
            {formSubmitButtonText}
          </button>
        </form>
      </div>

    </div>
  </section>
</BaseLayout>

