---
// src/pages/en/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import HeroInteractivo from "../../components/HeroInteractivo.astro";
import SobreNosotros from "../../components/SobreNosotros.astro";
import PorQueElegirnos from "../../components/PorQueElegirnos.astro";
import Estadisticas from "../../components/Estadisticas.astro";
import Clientes from "../../components/Clientes.astro";
import Ubicacion from "../../components/Ubicacion.astro";
import BlogPreview from "../../components/BlogPreview.astro";
import { getTranslation } from "../../utils/i18n";

const lang = "en";
const t = (key: string) => getTranslation(lang, key);
---

<BaseLayout title="SPS - Home" lang={lang}>
  <Hero />
  <SobreNosotros />
  <HeroInteractivo
    title={t("hero.title")}
    subtitle={t("hero.subtitle")}
    ctaText={t("hero.cta")}
    ctaLink={`/${lang}/${t("nav.services_url")}`}
  />
  <PorQueElegirnos />
  <Estadisticas />
  <Clientes />
  <BlogPreview />
  <Ubicacion />
</BaseLayout>
