---
// src/pages/es/servicios.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardServicio from '../../components/CardServicio.astro';
import ModalServicio from '../../components/ModalServicio.astro';
import { getServices, getServicesPage } from '../../lib/queries';
import { urlFor } from '../../lib/sanity';

// Consultar configuración de la página de servicios y servicios individuales
const servicesPageData = await getServicesPage();
const sanityServices = await getServices();

const badgeText = servicesPageData?.badgeText || 'Portafolio Institucional';
const pageTitle = servicesPageData?.title || 'Nuestros Servicios';
const pageSubtitle = servicesPageData?.subtitle || 'Soluciones integrales de protección corporativa, tecnología electrónica de vanguardia y consultoría de riesgos estratégicos.';
const ctaTitle = servicesPageData?.ctaTitle || '¿Necesitas una evaluación de seguridad personalizada?';
const ctaSubtitle = servicesPageData?.ctaSubtitle || 'Nuestros analistas y consultores están disponibles para auditar tus instalaciones y diseñar una propuesta a la medida de tu empresa.';

// Diccionario predeterminado con los puntos exactos solicitados en la imagen
const defaultItemsMap: Record<string, string[]> = {
  'instalaciones': ['Vigilancia personalizada', 'Supervisión operativa', 'Monitoreo en tiempo real'],
  'ejecutiva': ['Meet & Greet', 'Escoltas', 'Traslados y planificación de rutas'],
  'electronica': ['Cámaras y CCTV', 'Sistemas de alarma', 'Control de acceso', 'GPS'],
  'perdidas': ['Investigaciones internas', 'Prevención de pérdidas', 'Análisis de incidentes'],
  'industrial': ['Protocolos de seguridad', 'Evaluación de riesgos industriales'],
  'consultoria': ['Diagnóstico de seguridad', 'Diseño de estrategias de protección']
};

function getDetailItemsForService(s: any): string[] {
  if (s.detailItems && Array.isArray(s.detailItems) && s.detailItems.length > 0) {
    return s.detailItems;
  }
  if (s.highlights && Array.isArray(s.highlights) && s.highlights.length > 0) {
    return s.highlights;
  }

  const keyStr = `${s.slug?.current || s.slug || ''} ${s.title || ''}`.toLowerCase();
  if (keyStr.includes('instalacio')) return defaultItemsMap['instalaciones'];
  if (keyStr.includes('ejecutiv') || keyStr.includes('vip')) return defaultItemsMap['ejecutiva'];
  if (keyStr.includes('electron') || keyStr.includes('cctv')) return defaultItemsMap['electronica'];
  if (keyStr.includes('perdida') || keyStr.includes('investigacio')) return defaultItemsMap['perdidas'];
  if (keyStr.includes('industr')) return defaultItemsMap['industrial'];
  if (keyStr.includes('consultor')) return defaultItemsMap['consultoria'];

  return [];
}

// Fallbacks con los puntos exactos solicitados
const fallbackServices = [
  {
    _id: 'proteccion-instalaciones',
    title: 'Protección de instalaciones',
    badge: 'Vigilancia & Control',
    slug: { current: 'proteccion-de-instalaciones' },
    description: 'Resguardo físico integral para activos, plantas corporativas e infraestructuras estratégicas.',
    detailItems: defaultItemsMap['instalaciones'],
    iconSymbol: '🛡️'
  },
  {
    _id: 'proteccion-ejecutiva',
    title: 'Protección ejecutiva',
    badge: 'Resguardo VIP',
    slug: { current: 'proteccion-ejecutiva' },
    description: 'Servicio de movilidad segura y protección cercana para altos ejecutivos y diplomáticos.',
    detailItems: defaultItemsMap['ejecutiva'],
    iconSymbol: '👔'
  },
  {
    _id: 'seguridad-electronica',
    title: 'Seguridad electrónica',
    badge: 'Tecnología & CCTV',
    slug: { current: 'seguridad-electronica' },
    description: 'Integración tecnológica avanzada para videovigilancia, alarmas, control de acceso y geolocalización.',
    detailItems: defaultItemsMap['electronica'],
    iconSymbol: '📹'
  },
  {
    _id: 'control-perdidas',
    title: 'Control de pérdidas e investigaciones',
    badge: 'Auditoría & Prevención',
    slug: { current: 'control-de-perdidas-e-investigaciones' },
    description: 'Diagnósticos profundos para mitigar mermas, investigar irregularidades e identificar riesgos internos.',
    detailItems: defaultItemsMap['perdidas'],
    iconSymbol: '🔎'
  },
  {
    _id: 'seguridad-industrial',
    title: 'Seguridad industrial',
    badge: 'Prevención de Riesgos',
    slug: { current: 'seguridad-industrial' },
    description: 'Supervisión y protocolos de salud ocupacional, gestión ambiental y mitigación de riesgos industriales.',
    detailItems: defaultItemsMap['industrial'],
    iconSymbol: '⛑️'
  },
  {
    _id: 'consultoria',
    title: 'Consultoría',
    badge: 'Asesoría Estratégica',
    slug: { current: 'consultoria' },
    description: 'Evaluación estratégica de vulnerabilidades y elaboración de mapas de riesgos personalizados.',
    detailItems: defaultItemsMap['consultoria'],
    iconSymbol: '📞'
  }
];

const services = (sanityServices && sanityServices.length > 0)
  ? sanityServices.map((s: any) => ({
      _id: s._id,
      title: s.title,
      badge: s.badge || 'Servicio Especializado',
      slug: s.slug?.current || '#',
      description: s.description || 'Solución integral de seguridad adaptada a tus requerimientos.',
      detailedDescription: s.detailedDescription || s.description || '',
      detailItems: getDetailItemsForService(s),
      imageUrl: s.icon ? urlFor(s.icon)?.width(800).height(500).url() : null,
      galleryUrls: s.galleryUrls || []
    }))
  : fallbackServices.map((s: any) => ({
      _id: s._id,
      title: s.title,
      badge: s.badge,
      slug: s.slug.current,
      description: s.description,
      detailedDescription: s.description,
      detailItems: s.detailItems,
      icon: s.iconSymbol
    }));
---

<BaseLayout title="Servicios Especializados de Seguridad - SPS Risk" lang="es">
  <!-- Hero Encabezado de Servicios (Franja Azul Estilo Nosotros / Contacto) -->
  <section class="bg-gradient-to-r from-sps-navy via-[#073067] to-sps-blue text-white py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-sps-yellow/20 text-sps-yellow text-xs sm:text-sm font-bold tracking-wider uppercase mb-4">
        {badgeText}
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-oswald font-bold uppercase tracking-tight mb-6">
        {pageTitle}
      </h1>
      <p class="max-w-3xl mx-auto text-gray-200 text-base sm:text-lg font-light leading-relaxed whitespace-pre-line">
        {pageSubtitle}
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">

    <!-- Grid de Servicios (3 columnas) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {services.map((service: any) => (
        <CardServicio 
          id={service._id}
          title={service.title} 
          badge={service.badge}
          description={service.description}
          detailedDescription={service.detailedDescription}
          detailItems={service.detailItems}
          slug={service.slug}
          imageUrl={service.imageUrl}
          icon={service.icon}
          galleryUrls={service.galleryUrls}
        />
      ))}
    </div>

    <!-- CTA de Asesoría Gratuita -->
    <div class="bg-gradient-to-r from-sps-navy to-sps-blue text-white rounded-3xl p-10 lg:p-16 text-center max-w-4xl mx-auto shadow-2xl">
      <h2 class="text-3xl sm:text-4xl font-bold font-oswald mb-4 uppercase">{ctaTitle}</h2>
      <p class="text-gray-200 text-base sm:text-lg font-light mb-8 max-w-2xl mx-auto whitespace-pre-line">
        {ctaSubtitle}
      </p>
      <a href="/contacto" class="inline-block px-8 py-4 bg-sps-yellow text-sps-navy font-bold rounded-full hover:bg-white transition-colors shadow-lg text-sm uppercase tracking-wider">
        Solicitar evaluación sin costo
      </a>
    </div>

  </div>

  <!-- Modal Interactivo de Detalles -->
  <ModalServicio />
</BaseLayout>
