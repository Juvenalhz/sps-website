---
// src/pages/es/servicios/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllServiceSlugs, getServiceBySlug } from '../../../lib/queries';
import { urlFor } from '../../../lib/sanity';

export async function getStaticPaths() {
  const slugs = await getAllServiceSlugs();
  
  if (!slugs.length) {
    return [
      { params: { slug: 'cctv-inteligente' } },
      { params: { slug: 'proteccion-ejecutiva' } },
      { params: { slug: 'control-de-acceso' } }
    ];
  }

  return slugs.map((slug: any) => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;
const service = await getServiceBySlug(slug);

const title = service?.title || `Servicio: ${slug}`;
const description = service?.description || 'Solución integral de protección avanzada diseñada a la medida de tu organización.';
const iconUrl = service?.icon ? urlFor(service.icon)?.width(800).height(600).url() : 'https://images.unsplash.com/photo-1557597774-9d273605dfa9?auto=format&fit=crop&q=80&w=800';
---

<BaseLayout title={title} lang="es">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    
    <!-- Enlace Volver -->
    <a href="/es" class="inline-flex items-center gap-2 text-sps-blue hover:text-sps-navy font-medium text-sm mb-8 transition-colors">
      &larr; Volver al Inicio
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
      
      <!-- Columna Texto -->
      <div>
        <span class="text-xs font-bold text-sps-blue uppercase tracking-widest bg-sps-light-blue px-3 py-1 rounded-full inline-block mb-4">
          Servicios Especializados
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-sps-navy mb-6 leading-tight">
          {title}
        </h1>
        <p class="text-lg text-gray-600 font-light leading-relaxed mb-8">
          {description}
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="/contacto" class="px-8 py-3.5 bg-sps-blue hover:bg-sps-navy text-white font-bold text-sm rounded-full transition-all shadow-lg">
            Solicitar propuesta
          </a>
          <a href="tel:+582129525242" class="px-8 py-3.5 border-2 border-sps-navy text-sps-navy font-bold text-sm rounded-full hover:bg-sps-navy hover:text-white transition-all">
            Llamar a un especialista
          </a>
        </div>
      </div>

      <!-- Columna Imagen -->
      <div class="w-full h-[350px] sm:h-[450px] rounded-3xl overflow-hidden shadow-2xl bg-gray-100 relative border border-gray-200">
        <img 
          src={iconUrl} 
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>

    </div>

    <!-- Sección de Beneficios Clave -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 border-t border-gray-200">
      <div class="p-6 bg-gray-50 rounded-2xl">
        <div class="w-12 h-12 bg-sps-blue text-white rounded-xl flex items-center justify-center font-bold mb-4">01</div>
        <h3 class="font-bold text-lg text-sps-navy mb-2">Monitoreo y Respuesta 24/7</h3>
        <p class="text-sm text-gray-600">Personal entrenado y central de inteligencia activa continuamente.</p>
      </div>

      <div class="p-6 bg-gray-50 rounded-2xl">
        <div class="w-12 h-12 bg-sps-blue text-white rounded-xl flex items-center justify-center font-bold mb-4">02</div>
        <h3 class="font-bold text-lg text-sps-navy mb-2">Tecnología de Vanguardia</h3>
        <p class="text-sm text-gray-600">Integración con los estándares globales de seguridad y control.</p>
      </div>

      <div class="p-6 bg-gray-50 rounded-2xl">
        <div class="w-12 h-12 bg-sps-blue text-white rounded-xl flex items-center justify-center font-bold mb-4">03</div>
        <h3 class="font-bold text-lg text-sps-navy mb-2">Garantía y Confidencialidad</h3>
        <p class="text-sm text-gray-600">Protocolos estritos bajo certificaciones internacionales.</p>
      </div>
    </div>

  </div>
</BaseLayout>
