---
// src/components/Clientes.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();
const sanityClients = homeData?.clients || [];

const fallbackClientes = [
  { name: 'Mitsubishi', logoUrl: '/images/clientes/mitsubishi.png' },
  { name: 'ENI', logoUrl: '/images/clientes/eni.png' },
  { name: 'Repsol', logoUrl: '/images/clientes/repsol.png' },
  { name: 'Halliburton', logoUrl: '/images/clientes/halliburton.png' },
  { name: 'Statoil', logoUrl: '/images/clientes/statoil.png' },
  { name: 'Firestone', logoUrl: '/images/clientes/firestone.png' }
];

interface SanityClient {
  name?: string;
  logo?: any;
}

const baseClientes = sanityClients.length > 0
  ? sanityClients.map((c: SanityClient) => ({
      name: c.name || 'Cliente',
      logoUrl: c.logo ? urlFor(c.logo)?.url() : null
    })).filter((c: any) => c.logoUrl)
  : fallbackClientes;

// Duplicamos la lista para lograr una animación en bucle infinito continuo
const clientesList = [...baseClientes, ...baseClientes, ...baseClientes];
---

<section class="w-full py-16 pb-24 overflow-hidden">
  
  <!-- Divisor con texto en el medio -->
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 mb-12">
    <div class="flex items-center justify-center">
      <div class="flex-grow border-t border-gray-200"></div>
      <span class="flex-shrink-0 mx-6 text-gray-400 text-xs sm:text-sm font-bold tracking-widest uppercase">
        Empresas que confían en nosotros
      </span>
      <div class="flex-grow border-t border-gray-200"></div>
    </div>
  </div>

  <!-- Carrusel Infinito Deslizante (Marquee) -->
  <div class="relative w-full overflow-hidden">
    <!-- Sombras degradadas en los bordes para difuminado suave -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-20 sm:w-36 bg-gradient-to-r from-white via-white/80 to-transparent z-10"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-20 sm:w-36 bg-gradient-to-l from-white via-white/80 to-transparent z-10"></div>

    <!-- Track Animado -->
    <div class="flex items-center gap-12 sm:gap-16 w-max animate-marquee hover:[animation-play-state:paused] py-4">
      {clientesList.map((cliente: any) => (
        <div class="flex items-center justify-center shrink-0 w-32 sm:w-40 transition-all duration-300 opacity-80 hover:opacity-100 hover:scale-110 cursor-pointer">
          <img 
            src={cliente.logoUrl} 
            alt={`Logo de ${cliente.name}`} 
            class="max-w-full h-auto object-contain max-h-12 sm:max-h-16 filter grayscale hover:grayscale-0 transition-all duration-300"
            loading="lazy"
            onerror="this.style.display='none';"
          />
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-33.3333%);
    }
  }

  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>
