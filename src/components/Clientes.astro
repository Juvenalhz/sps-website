---
// src/components/Clientes.astro

const clientes = [
  { id: 'mitsubishi', name: 'Mitsubishi' },
  { id: 'eni', name: 'ENI' },
  { id: 'repsol', name: 'Repsol' },
  { id: 'halliburton', name: 'Halliburton' },
  { id: 'statoil', name: 'Statoil' },
  { id: 'firestone', name: 'Firestone' }
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 pb-24">
  
  <!-- Divisor con texto en el medio (Igual al de Certificaciones) -->
  <div class="flex items-center justify-center mb-12 lg:mb-16">
    <div class="flex-grow max-w-3xl border-t border-gray-200"></div>
    <span class="flex-shrink-0 mx-6 text-gray-400 text-xl font-light tracking-wide">Clientes</span>
    <div class="flex-grow max-w-3xl border-t border-gray-200"></div>
  </div>

  <!-- Carrusel/Grid de Logos -->
  <!-- Usamos flex-wrap para que se acomoden en pantallas pequeñas, y justify-between/center en grandes -->
  <div class="flex flex-wrap justify-center lg:justify-between items-center gap-12 lg:gap-8 px-4 lg:px-12">
    
    {clientes.map((cliente) => (
      <div class="flex flex-col items-center justify-center w-28 sm:w-32 lg:w-36 transition-transform hover:scale-105">
        
        <img 
          src={`/images/clientes/${cliente.id}.png`} 
          alt={`Logo de ${cliente.name}`} 
          class="max-w-full h-auto object-contain max-h-16 lg:max-h-20"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        
        <!-- Placeholder en caso de que no exista la imagen aún -->
        <div class="hidden border border-dashed border-gray-300 w-full h-16 items-center justify-center text-center text-gray-300 rounded bg-gray-50/50">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
          </svg>
        </div>

      </div>
    ))}

  </div>

</section>
