---

<section class="relative w-full h-[600px] lg:h-[80vh] overflow-hidden bg-gray-900">
  <!-- Imagen de fondo principal -->
  <img 
    src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&q=80&w=2070" 
    alt="Fondo Interactivo" 
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div class="absolute inset-0 w-full h-full">
    <!-- Texto sutil opcional en la parte inferior (como "Nuestros servicios" en tu imagen) -->
    <div class="absolute bottom-8 left-0 right-0 text-center pointer-events-none z-10">
      <h2 class="text-2xl md:text-3xl font-light text-white drop-shadow-md">
        Nuestros servicios
      </h2>
    </div>

    <!-- Contenedor de hotspots -->
    <div class="absolute inset-0 w-full h-full max-w-7xl mx-auto relative">
      {hotspots.map((hotspot) => (
        <div class="absolute group hotspot-wrapper z-10" style={`top: ${hotspot.position.top}; left: ${hotspot.position.left}; transform: translate(-50%, -50%);`}>
          <!-- Botón Hotspot: Ahora más grande (w-20 h-20) y con borde gris transparente -->
          <button 
            type="button" 
            class="hotspot-btn relative flex items-center justify-center w-20 h-20 bg-white/40 backdrop-blur-sm rounded-full shadow-lg border-[3px] border-gray-400 hover:scale-110 hover:bg-white/70 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-4 focus:ring-gray-400/50 z-20"
            aria-label={`Ver detalles de ${hotspot.title}`}
            data-target={`tooltip-${hotspot.id}`}
          >
            <!-- Efecto de onda atenuado para no distraer demasiado -->
            <span class="absolute inline-flex h-full w-full rounded-full bg-gray-300 opacity-20 animate-ping"></span>
            
            <!-- Icono -->
            <span class="relative z-10 flex items-center justify-center" set:html={hotspot.icon} />
          </button>

          <!-- Tooltip (Modal flotante) -->
          <div 
            id={`tooltip-${hotspot.id}`} 
            class="hotspot-tooltip hidden absolute z-30 w-72 p-6 rounded-2xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-white/40 dark:border-slate-700/50 shadow-[0_8px_30px_rgb(0,0,0,0.15)] transition-opacity duration-300"
            role="tooltip"
          >
            <!-- Flechita decorativa del tooltip -->
            <div class="tooltip-arrow absolute w-4 h-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl rotate-45 border-l border-t border-white/40 dark:border-slate-700/50"></div>
            
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{hotspot.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-5">{hotspot.description}</p>
            <a href="/servicios" class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-full text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
              Más información
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ========================================== -->
<!-- LÓGICA: Floating UI para posicionar tooltips -->
<!-- ========================================== -->
<script>
  // @ts-nocheck
  import { computePosition, flip, shift, offset, arrow } from "@floating-ui/dom";

  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll('.hotspot-btn');
    
    function updatePosition(button, tooltip) {
      const arrowElement = tooltip.querySelector('.tooltip-arrow');
      
      computePosition(button, tooltip, {
        placement: "top",
        middleware: [
          offset(20), // Separación entre botón y tooltip
          flip(),
          shift({ padding: 20 }),
          arrow({ element: arrowElement })
        ],
      }).then(({ x, y, placement, middlewareData }) => {
        Object.assign(tooltip.style, {
          left: `${x}px`,
          top: `${y}px`,
        });

        if (middlewareData.arrow && arrowElement) {
          const { x: arrowX, y: arrowY } = middlewareData.arrow;
          
          const staticSide = {
            top: 'bottom',
            right: 'left',
            bottom: 'top',
            left: 'right',
          }[placement.split('-')[0]];

          Object.assign(arrowElement.style, {
            left: arrowX != null ? `${arrowX}px` : '',
            top: arrowY != null ? `${arrowY}px` : '',
            right: '',
            bottom: '',
            [staticSide]: '-8px', // offset para la flecha
          });
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        
        const targetId = btn.getAttribute("data-target");
        const tooltip = document.getElementById(targetId);
        const isHidden = tooltip.classList.contains("hidden");

        // Primero, ocultar todos los tooltips y reiniciar los z-index de los wrappers
        document.querySelectorAll('.hotspot-tooltip').forEach(t => {
          t.classList.add("hidden");
        });
        document.querySelectorAll('.hotspot-wrapper').forEach(w => {
          w.classList.remove("z-50");
          w.classList.add("z-10");
        });

        // Si estaba oculto, mostrarlo, posicionarlo y subir el z-index de su contenedor
        if (isHidden) {
          tooltip.classList.remove("hidden");
          const wrapper = btn.closest('.hotspot-wrapper');
          if (wrapper) {
            wrapper.classList.remove("z-10");
            wrapper.classList.add("z-50");
          }
          requestAnimationFrame(() => {
             updatePosition(btn, tooltip);
          });
        }
      });
    });

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!target.closest('.hotspot-tooltip') && !target.closest('.hotspot-btn')) {
        document.querySelectorAll('.hotspot-tooltip').forEach(t => {
          t.classList.add("hidden");
        });
        document.querySelectorAll('.hotspot-wrapper').forEach(w => {
          w.classList.remove("z-50");
          w.classList.add("z-10");
        });
      }
    });
    
    window.addEventListener('resize', () => {
       buttons.forEach((btn) => {
          const targetId = btn.getAttribute("data-target");
          const tooltip = document.getElementById(targetId);
          if(!tooltip.classList.contains("hidden")){
            updatePosition(btn, tooltip);
          }
       });
    });
  });
</script>
