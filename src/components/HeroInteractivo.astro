---
// src/components/HeroInteractivo.astro
import { getHomePage, getServices } from '../lib/queries';
import { urlFor } from '../lib/sanity';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  lang?: string;
}

const { lang = 'es' } = Astro.props;

// Consultar datos de Sanity
const homePageData = await getHomePage();
const sanityServices = await getServices();

// Imagen de fondo interactiva desde Sanity o fallback por defecto
const bgImageUrl = homePageData?.interactiveBgUrl || 
  (homePageData?.interactiveBackgroundImage ? urlFor(homePageData.interactiveBackgroundImage)?.url() : null) || 
  "https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&q=80&w=2070";

// Fallback de las posiciones predeterminadas para los hotspots (Alineación con separación visual)
const defaultPositions = [
  { top: '18%', left: '14%', placement: 'right-start' }, // Cámara CCTV (arriba izquierda)
  { top: '68%', left: '51%', placement: 'top' },         // Laptop (escritorio centro)
  { top: '40%', left: '68%', placement: 'left' },        // Radio (arriba del escritorio a la derecha)
  { top: '75%', left: '69%', placement: 'top' },         // Teléfono (escritorio inferior derecha)
  { top: '65%', left: '90%', placement: 'left' },        // Casco (silla derecha)
];

const fallbackSvgIcons = [
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`,
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 4h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V6a2 2 0 012-2zm4-2v2m-2 4h4m-4 4h4"></path></svg>`,
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.125A59.769 59.769 0 0121.485 12 59.768 59.768 0 013.27 20.875L5.999 12Zm0 0h7.5" /></svg>`,
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" /></svg>`,
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.54-4.24-7.136-7.136l1.292-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>`,
  `<svg class="w-12 h-12 text-white drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
];

// Fallback estático
const staticHotspots = [
  {
    id: 'cctv',
    title: 'CCTV Inteligente',
    slug: 'cctv-inteligente',
    description: 'Monitoreo continuo con reconocimiento facial y detección de objetos.',
    iconSvg: fallbackSvgIcons[0],
    position: { top: '15%', left: '20%' },
    placement: 'right-start',
  },
  {
    id: 'comunicaciones',
    title: 'Comunicaciones',
    slug: 'comunicaciones',
    description: 'Radios de dos vías encriptados para coordinación inmediata de nuestro personal.',
    iconSvg: fallbackSvgIcons[1],
    position: { top: '55%', left: '22%' },
    placement: 'right',
  },
  {
    id: 'proteccion-vip',
    title: 'Protección Ejecutiva VIP',
    slug: 'proteccion-ejecutiva',
    description: 'Traslados seguros nacionales e internacionales con escoltas altamente entrenados.',
    iconSvg: fallbackSvgIcons[2],
    position: { top: '35%', left: '80%' },
    placement: 'left-start',
  },
  {
    id: 'ciberseguridad',
    title: 'Ciberseguridad',
    slug: 'ciberseguridad',
    description: 'Protección de infraestructura crítica, redes y datos corporativos.',
    iconSvg: fallbackSvgIcons[3],
    position: { top: '75%', left: '50%' },
    placement: 'top',
  },
  {
    id: 'emergencia',
    title: 'Línea de Emergencia',
    slug: 'linea-de-emergencia',
    description: 'Soporte 24/7 y atención a incidentes críticos al instante.',
    iconSvg: fallbackSvgIcons[4],
    position: { top: '75%', left: '72%' },
    placement: 'left',
  },
  {
    id: 'seguridad-industrial',
    title: 'Seguridad Industrial',
    slug: 'seguridad-industrial',
    description: 'Protocolos de prevención y protección en plantas e instalaciones industriales.',
    iconSvg: fallbackSvgIcons[5],
    position: { top: '70%', left: '90%' },
    placement: 'left',
  }
];

// Procesamiento dinámico de hotspots desde Sanity
let hotspots: any[] = [];

if (homePageData?.hotspots && homePageData.hotspots.length > 0) {
  hotspots = homePageData.hotspots.map((item: any, index: number) => {
    const service = item.service || {};
    const defaultPos = defaultPositions[index % defaultPositions.length];
    
    const topVal = item.position?.topPercent !== undefined ? `${item.position.topPercent}%` : defaultPos.top;
    const leftVal = item.position?.leftPercent !== undefined ? `${item.position.leftPercent}%` : defaultPos.left;

    const customImgUrl = item.customImage ? urlFor(item.customImage)?.url() : null;
    const serviceImgUrl = service.icon ? urlFor(service.icon)?.width(300).height(300).url() : null;
    const imageUrl = customImgUrl || serviceImgUrl;
    const slugCurrent = service.slug?.current || '';
    const linkUrl = '/servicios';

    return {
      id: item._key || service._id || `hotspot-${index}`,
      title: item.customTitle || service.title || `Servicio ${index + 1}`,
      slug: slugCurrent,
      description: item.customDescription || service.description || 'Solución integral de seguridad adaptada a tus requerimientos.',
      imageUrl: imageUrl,
      iconSvg: fallbackSvgIcons[index % fallbackSvgIcons.length],
      position: { top: topVal, left: leftVal },
      placement: item.placement || defaultPos.placement,
      linkUrl: linkUrl
    };
  });
} else if (sanityServices && sanityServices.length > 0) {
  hotspots = sanityServices.map((service: any, index: number) => {
    const defaultPos = defaultPositions[index % defaultPositions.length];
    const imageUrl = service.icon ? urlFor(service.icon)?.width(100).height(100).url() : null;
    const slugCurrent = service.slug?.current || '';
    const linkUrl = '/servicios';

    return {
      id: service._id || `service-${index}`,
      title: service.title,
      slug: slugCurrent,
      description: service.description || 'Solución integral de seguridad adaptada a tus requerimientos.',
      imageUrl: imageUrl,
      iconSvg: fallbackSvgIcons[index % fallbackSvgIcons.length],
      position: defaultPos,
      placement: defaultPos.placement,
      linkUrl: linkUrl
    };
  });
} else {
  hotspots = staticHotspots.map((item) => ({
    ...item,
    linkUrl: '/servicios'
  }));
}
---

<!-- Versión Desktop: Banner Interactivo con Hotspots Dinámicos -->
<section class="hidden md:block relative w-full h-[90vh] min-h-[600px] max-h-[950px] overflow-hidden bg-slate-950">
  <!-- Imagen de fondo principal (Optimizada para 1920x900 a 90vh) -->
  <img 
    src={bgImageUrl} 
    alt="Fondo Interactivo de Servicios" 
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <div class="absolute inset-0 w-full h-full bg-black/10">
    <!-- Contenedor de hotspots (se escala idénticamente a la imagen 16:9) -->
    <div class="absolute inset-0 w-full h-full">
      {hotspots.map((hotspot) => (
        <div class="absolute group hotspot-wrapper z-10" style={`top: ${hotspot.position.top}; left: ${hotspot.position.left}; transform: translate(-50%, -50%);`}>
          <!-- Botón Hotspot Cristalino Semitransparente (Imagen Grande al 95% del Círculo) -->
          <button 
            type="button" 
            class="hotspot-btn relative flex items-center justify-center w-22 h-22 sm:w-28 sm:h-28 lg:w-34 lg:h-34 bg-black/45 backdrop-blur-md rounded-full shadow-2xl border-[3.5px] sm:border-[4.5px] border-white/85 hover:scale-110 hover:bg-black/65 hover:border-white transition-all duration-300 cursor-pointer focus:outline-none focus:ring-4 focus:ring-white/40 z-20 p-1.5 sm:p-2 lg:p-2.5"
            aria-label={`Ver detalles de ${hotspot.title}`}
            data-target={`tooltip-${hotspot.id}`}
            data-placement={hotspot.placement}
          >
            {hotspot.imageUrl ? (
              <img src={hotspot.imageUrl} alt={hotspot.title} class="relative z-10 w-full h-full object-contain filter drop-shadow-lg transition-transform group-hover:scale-110" />
            ) : (
              <span class="relative z-10 flex items-center justify-center w-full h-full [&>svg]:w-full [&>svg]:h-full" set:html={hotspot.iconSvg} />
            )}
          </button>

          <!-- Tooltip (Modal flotante) -->
          <div 
            id={`tooltip-${hotspot.id}`} 
            class="hotspot-tooltip hidden absolute z-30 w-72 p-6 rounded-2xl bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border border-white/40 dark:border-slate-700/50 shadow-[0_8px_30px_rgb(0,0,0,0.15)] transition-opacity duration-300"
            role="tooltip"
          >
            <div class="tooltip-arrow absolute w-4 h-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl rotate-45 border-l border-t border-white/40 dark:border-slate-700/50"></div>
            
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{hotspot.title}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-5">{hotspot.description}</p>
            <a href={hotspot.linkUrl} class="inline-flex items-center justify-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-full text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
              Más información
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Versión Móvil: Grid de Tarjetas Limpias (Evita solapamiento en pantallas pequeñas) -->
<section class="block md:hidden bg-sps-navy py-16 px-6 text-white">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <span class="text-sps-yellow font-bold uppercase text-xs tracking-wider">Soluciones Integrales</span>
      <h2 class="text-3xl font-oswald font-bold uppercase tracking-tight mt-1">Nuestros Servicios</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {hotspots.map((hotspot) => (
        <div class="p-6 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 flex flex-col justify-between space-y-4">
          <div class="flex items-center gap-4">
            {hotspot.imageUrl ? (
              <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0 p-2">
                <img src={hotspot.imageUrl} alt={hotspot.title} class="w-full h-full object-contain" />
              </div>
            ) : (
              <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center shrink-0 [&>svg]:w-6 [&>svg]:h-6 [&>svg]:text-sps-yellow" set:html={hotspot.iconSvg} />
            )}
            <h3 class="font-bold text-lg text-white font-oswald">{hotspot.title}</h3>
          </div>
          <p class="text-sm text-gray-200 font-light leading-relaxed">
            {hotspot.description}
          </p>
          <a 
            href={hotspot.linkUrl} 
            class="inline-block text-center text-xs font-bold uppercase tracking-wider text-sps-yellow hover:text-white border border-sps-yellow/40 hover:border-white rounded-full py-2.5 px-4 transition-colors"
          >
            Más información
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ========================================== -->
<!-- LÓGICA: Floating UI para posicionar tooltips -->
<!-- ========================================== -->
<script>
  // @ts-nocheck
  import { computePosition, flip, shift, offset, arrow } from "@floating-ui/dom";

  function updatePosition(button, tooltip) {
    const arrowElement = tooltip.querySelector('.tooltip-arrow');
    const preferredPlacement = button.getAttribute('data-placement') || 'top';
    
    computePosition(button, tooltip, {
      placement: preferredPlacement,
      middleware: [
        offset(20), // Separación entre botón y tooltip
        flip({
          fallbackPlacements: ['top', 'right', 'bottom', 'left', 'right-start', 'left-start', 'top-start', 'bottom-start']
        }),
        shift({ padding: 20 }),
        arrow({ element: arrowElement })
      ],
    }).then(({ x, y, placement, middlewareData }) => {
      Object.assign(tooltip.style, {
        left: `${x}px`,
        top: `${y}px`,
      });

      if (middlewareData.arrow && arrowElement) {
        const { x: arrowX, y: arrowY } = middlewareData.arrow;
        
        const staticSide = {
          top: 'bottom',
          right: 'left',
          bottom: 'top',
          left: 'right',
        }[placement.split('-')[0]];

        Object.assign(arrowElement.style, {
          left: arrowX != null ? `${arrowX}px` : '',
          top: arrowY != null ? `${arrowY}px` : '',
          right: '',
          bottom: '',
          [staticSide]: '-8px', // offset para la flecha
        });
      }
    });
  }

  function initHeroInteractivo() {
    const wrappers = document.querySelectorAll('.hotspot-wrapper');
    if (!wrappers.length) return;

    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.heroInitialized) return;
      wrapper.dataset.heroInitialized = "true";

      const btn = wrapper.querySelector('.hotspot-btn');
      if (!btn) return;

      const targetId = btn.getAttribute("data-target");
      const tooltip = document.getElementById(targetId);
      if (!tooltip) return;

      let hideTimeout = null;

      const showTooltip = () => {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
          hideTimeout = null;
        }

        // Primero, ocultar todos los otros tooltips y reiniciar los z-index
        document.querySelectorAll('.hotspot-tooltip').forEach(t => {
          if (t !== tooltip) t.classList.add("hidden");
        });
        document.querySelectorAll('.hotspot-wrapper').forEach(w => {
          if (w !== wrapper) {
            w.classList.remove("z-50");
            w.classList.add("z-10");
          }
        });

        // Mostrar el tooltip actual y subir z-index de su contenedor
        tooltip.classList.remove("hidden");
        wrapper.classList.remove("z-10");
        wrapper.classList.add("z-50");

        requestAnimationFrame(() => {
          updatePosition(btn, tooltip);
        });
      };

      const hideTooltip = () => {
        hideTimeout = setTimeout(() => {
          tooltip.classList.add("hidden");
          wrapper.classList.remove("z-50");
          wrapper.classList.add("z-10");
        }, 150);
      };

      // Eventos Hover para Desktop
      wrapper.addEventListener("mouseenter", showTooltip);
      wrapper.addEventListener("mouseleave", hideTooltip);

      tooltip.addEventListener("mouseenter", () => {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
          hideTimeout = null;
        }
      });
      tooltip.addEventListener("mouseleave", hideTooltip);

      // Evento Click para soporte táctil (Móvil/Tablet)
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isHidden = tooltip.classList.contains("hidden");
        if (isHidden) {
          showTooltip();
        } else {
          tooltip.classList.add("hidden");
          wrapper.classList.remove("z-50");
          wrapper.classList.add("z-10");
        }
      });
    });

    if (!window._heroInteractivoListenersAdded) {
      window._heroInteractivoListenersAdded = true;
      document.addEventListener("click", (e) => {
        const target = e.target;
        if (target && !target.closest('.hotspot-tooltip') && !target.closest('.hotspot-btn')) {
          document.querySelectorAll('.hotspot-tooltip').forEach(t => {
            t.classList.add("hidden");
          });
          document.querySelectorAll('.hotspot-wrapper').forEach(w => {
            w.classList.remove("z-50");
            w.classList.add("z-10");
          });
        }
      });
      
      window.addEventListener('resize', () => {
        document.querySelectorAll('.hotspot-btn').forEach((btn) => {
          const targetId = btn.getAttribute("data-target");
          const tooltip = document.getElementById(targetId);
          if (tooltip && !tooltip.classList.contains("hidden")) {
            updatePosition(btn, tooltip);
          }
        });
      });
    }
  }

  initHeroInteractivo();
  document.addEventListener('astro:page-load', initHeroInteractivo);
</script>
</script>
