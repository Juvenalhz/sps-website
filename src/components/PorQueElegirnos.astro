---
// src/components/PorQueElegirnos.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();
const whyUsTitle = homeData?.whyUsTitle || '¿POR QUÉ ELEGIRNOS?';
const whyUsImageUrl = homeData?.whyUsImage
  ? urlFor(homeData.whyUsImage)?.url()
  : '/images/guardia.png';

const fallbackWhyUsItems = [
  { title: 'Sólida trayectoria:', description: 'Más de 20 años de operación ininterrumpida.' },
  { title: 'Enfoque estratégico:', description: 'Seguridad como un todo, no piezas aisladas.' },
  { title: 'Soluciones personalizadas:', description: 'Evaluamos los riesgos de tu empresa con nuestros expertos.' },
  { title: 'Estándares internacionales:', description: 'No lo decimos nosotros, sino entes certificadores.' }
];

const whyUsItems = homeData?.whyUsItems && homeData.whyUsItems.length > 0
  ? homeData.whyUsItems
  : fallbackWhyUsItems;
---

<section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 lg:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center">
    
    <!-- Lado Izquierdo: Imagen del Guardia -->
    <div class="relative w-full flex justify-center items-center">
      <img
        src={whyUsImageUrl}
        alt="Guardia de Seguridad SPS"
        class="w-full max-w-md lg:max-w-lg h-auto object-contain drop-shadow-xl"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      
      <!-- Placeholder en caso de que no haya imagen subida -->
      <div
        class="hidden w-full h-[450px] flex-col items-center justify-center text-center text-gray-300 p-6 border-2 border-dashed border-gray-300 rounded-[30px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
    </div>

    <!-- Lado Derecho: Contenido -->
    <div>
      <h2
        class="text-4xl lg:text-5xl font-oswald font-bold text-sps-blue uppercase mb-12 tracking-tight"
      >
        {whyUsTitle}
      </h2>
      
      <div class="space-y-8 mb-12">
        {whyUsItems.map((item: any) => (
          <div class="flex gap-5 items-start">
            <div class="text-sps-blue w-12 h-12 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-xl text-gray-700 mb-1">{item.title}</h3>
              <p class="text-gray-500 text-[16px]">{item.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Botón -->
      <a
        href="/contacto"
        class="inline-block px-8 py-2.5 rounded-full border border-gray-500 text-gray-700 hover:bg-sps-navy hover:text-white hover:border-sps-navy transition-all text-xs font-bold uppercase tracking-wider"
      >
        Más información
      </a>
    </div>
    
  </div>
</section>
