---
// src/components/SobreNosotros.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();
const aboutTitle = homeData?.aboutTitle || 'Sobre Nosotros';
const aboutText = homeData?.aboutText || 'En SPS Seguridad nos especializamos en la prevención, gestión de riesgos e implementación de tecnología de punta para salvaguardar empresas, instituciones e industrias con más de 20 años de experiencia.';
const aboutImageUrl = homeData?.aboutImage
  ? urlFor(homeData.aboutImage)?.url()
  : '/images/sobre-nosotros.jpg';
---

<section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 lg:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    
    <!-- Lado Izquierdo: Imagen con diseño asimétrico -->
    <div class="relative w-full">
      <img
        src={aboutImageUrl}
        alt={aboutTitle}
        class="w-full h-auto object-cover rounded-tl-[120px] rounded-br-[120px] rounded-tr-lg rounded-bl-lg shadow-xl relative z-10"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <!-- Placeholder de respaldo -->
      <div
        class="hidden w-full h-[400px] bg-gray-100 border-2 border-dashed border-gray-300 rounded-tl-[120px] rounded-br-[120px] rounded-tr-lg rounded-bl-lg items-center justify-center text-gray-300 z-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
    </div>

    <!-- Lado Derecho: Textos y Botón -->
    <div>
      <h2
        class="text-4xl lg:text-5xl font-oswald font-bold text-sps-blue uppercase mb-6 tracking-tight"
      >
        {aboutTitle}
      </h2>
      
      <p class="text-gray-500 text-[17px] leading-relaxed mb-8 whitespace-pre-line">
        {aboutText}
      </p>

      <a
        href="/nosotros"
        class="inline-block bg-sps-navy text-white px-8 py-3 rounded-full font-bold hover:bg-sps-blue transition-colors shadow-md text-sm uppercase tracking-wider"
      >
        Conocer nuestra empresa
      </a>
    </div>
    
  </div>
</section>
