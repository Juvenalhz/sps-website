---
// src/components/SobreNosotros.astro
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    
    <!-- Lado Izquierdo: Imagen con diseño asimétrico -->
    <div class="relative w-full">
      <!-- 
        Usa rounded-tl-[120px] y rounded-br-[120px] para lograr el efecto de 
        esquinas redondeadas opuestas que se ve en el diseño.
      -->
      <img
        src="/images/sobre-nosotros.jpg"
        alt="Equipo Directivo SPS"
        class="w-full h-auto object-cover rounded-tl-[120px] rounded-br-[120px] rounded-tr-lg rounded-bl-lg shadow-xl relative z-10"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <!-- Placeholder de respaldo en caso de que aún no hayas subido la imagen -->
      <div
        class="hidden w-full h-[400px] bg-gray-100 border-2 border-dashed border-gray-300 rounded-tl-[120px] rounded-br-[120px] rounded-tr-lg rounded-bl-lg items-center justify-center text-gray-500 z-0"
      >
        [Imagen Sobre Nosotros (public/images/sobre-nosotros.jpg)]
      </div>
    </div>

    <!-- Lado Derecho: Textos y Botón -->
    <div>
      <h2
        class="text-4xl lg:text-5xl font-oswald font-bold text-sps-blue uppercase mb-6 tracking-tight"
      >
        Sobre Nosotros
      </h2>
      
      <p class="text-gray-500 text-[17px] leading-relaxed mb-8">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
        commodo consequat.
      </p>

      <a
        href="/contacto"
        class="inline-block bg-sps-navy text-white px-8 py-2 rounded font-bold hover:bg-sps-blue transition-colors shadow-md text-sm"
      >
        Contactar ahora
      </a>
    </div>
    
  </div>
</section>
