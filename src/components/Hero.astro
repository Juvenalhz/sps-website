---
// src/components/Hero.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();

const heroTitle = homeData?.heroTitle || 'SOLUCIONES INTEGRALES DE SEGURIDAD Y GESTIÓN DE RIESGOS';
const heroSubtitle = homeData?.heroSubtitle || 'Protegemos personas, activos y operaciones con estándares internacionales.';

// Orden de prioridad del fondo:
// 1. Video desde Sanity (archivo subido o URL externa)
// 2. Imagen desde Sanity (si no hay video en Sanity)
// 3. Video local por defecto (fallback si no se ha subido nada en Sanity)
const sanityVideoUrl = homeData?.heroVideoUrl || null;
const sanityImageUrl = homeData?.heroImage ? urlFor(homeData.heroImage)?.url() : null;
const fallbackVideoUrl = '/videos/hero-monitoreo.mp4';

const activeVideoUrl = sanityVideoUrl || (!sanityImageUrl ? fallbackVideoUrl : null);
---

<section
    class="relative w-full h-[90vh] min-h-[600px] bg-sps-navy flex items-center overflow-hidden"
>
    <!-- FONDO: Video o Imagen que inicia desde la parte superior (y=0) -->
    <div class="absolute inset-0 z-0 overflow-hidden">
        {activeVideoUrl ? (
            <video
                autoplay
                muted
                loop
                playsinline
                class="w-full h-full object-cover object-center"
            >
                <source src={activeVideoUrl} type="video/mp4" />
                Tu navegador no soporta videos HTML5.
            </video>
        ) : sanityImageUrl ? (
            <img 
                src={sanityImageUrl} 
                alt={heroTitle} 
                class="w-full h-full object-cover object-center" 
            />
        ) : null}

    </div>

    <!-- CONTENIDO PRINCIPAL (con padding superior para el header transparente) -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-28 lg:pt-32 pb-12">
        <div class="max-w-5xl lg:w-3/4">
            <!-- Título principal -->
            <h1
                class="text-4xl sm:text-5xl lg:text-5xl font-oswald font-normal text-white tracking-tight leading-none mb-5 uppercase drop-shadow-lg whitespace-pre-line"
            >
                {heroTitle}
            </h1>

            <!-- Subtítulo con barra lateral amarilla -->
            <div class="border-l-[3px] border-sps-yellow pl-5 mb-8">
                <p
                    class="text-base sm:text-[19px] text-white font-bold leading-snug drop-shadow-md whitespace-pre-line"
                >
                    {heroSubtitle}
                </p>
            </div>

            <!-- Botón de Acción -->
            <a
                href="/contacto"
                class="inline-flex items-center gap-3 group mt-2"
            >
                <div
                    class="w-8 h-8 bg-sps-yellow text-sps-navy flex items-center justify-center transition-transform group-hover:scale-105"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                    </svg>
                </div>
                <span
                    class="text-gray-300 text-[15px] font-normal group-hover:text-white transition-colors"
                    >Solicitar evaluación</span
                >
            </a>
        </div>
    </div>
</section>
