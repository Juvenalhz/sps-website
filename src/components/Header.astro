---
// src/components/Header.astro
import { getSiteSettings } from '../lib/queries';
import { urlFor } from '../lib/sanity';

interface Props {
  lang?: 'es' | 'en';
}

const { lang } = Astro.props;
const currentLang = lang || (Astro.url.pathname.startsWith('/en') ? 'en' : 'es');

const settings = await getSiteSettings();
const logoUrl = settings?.logo ? urlFor(settings.logo)?.url() : null;
const siteTitle = settings?.siteTitle || 'SPS';
---

<header
  class="bg-white border-b-4 border-sps-blue py-4 shadow-sm sticky top-0 z-50"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center"
  >
    <!-- Logo SPS (Sanity o Texto Fallback) -->
    <a href="/" class="flex items-center gap-2">
      {logoUrl ? (
        <img src={logoUrl} alt={siteTitle} class="h-10 w-auto object-contain" />
      ) : (
        <div class="text-3xl font-extrabold text-sps-blue tracking-tighter">
          {siteTitle}
        </div>
      )}
    </a>

    <!-- Navegación Desktop -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/nosotros"
        class="text-sm font-bold text-sps-blue hover:text-sps-navy transition-colors"
        >Sobre Nosotros</a
      >
      <a
        href="/servicios"
        class="text-sm font-bold text-sps-blue hover:text-sps-navy transition-colors"
        >Servicios</a
      >
      <a
        href="/blog"
        class="text-sm font-bold text-sps-blue hover:text-sps-navy transition-colors"
        >Blog</a
      >
      <a
        href="/contacto"
        class="text-sm font-bold text-sps-blue hover:text-sps-navy transition-colors"
        >Contacto</a
      >
    </nav>

    <!-- Botones y Banderas Desktop -->
    <div class="hidden md:flex items-center gap-6">
      <!-- Selector de Idioma -->
      <div class="flex items-center gap-3 border-r-2 border-gray-200 pr-6">
        <button
          type="button"
          id="btn-lang-es"
          title="Español (Venezuela)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 hover:scale-105 cursor-pointer p-0.5 rounded"
        >
          <img
            src="https://flagcdn.com/w20/ve.png"
            alt="Bandera Venezuela"
            class="w-6 h-auto rounded-sm"
          />
        </button>
        <button
          type="button"
          id="btn-lang-en"
          title="English (USA)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 hover:scale-105 cursor-pointer p-0.5 rounded"
        >
          <img
            src="https://flagcdn.com/w20/us.png"
            alt="Bandera USA"
            class="w-6 h-auto rounded-sm"
          />
        </button>
      </div>

      <!-- Botón Call to Action -->
      <a
        href="/contacto"
        class="bg-sps-blue text-white px-6 py-2.5 rounded-full font-bold text-sm hover:bg-sps-navy transition-all shadow-md"
      >
        Solicitar evaluación
      </a>
    </div>

    <!-- Botón Menú Hamburguesa (Móvil) -->
    <button 
      type="button"
      id="btn-mobile-toggle" 
      class="md:hidden text-sps-blue p-2 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer" 
      aria-label="Menú principal"
    >
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-6 py-6 space-y-5 shadow-xl transition-all">
    <nav class="flex flex-col space-y-4">
      <a
        href="/nosotros"
        class="text-base font-bold text-sps-blue hover:text-sps-navy transition-colors py-1"
        >Sobre Nosotros</a
      >
      <a
        href="/servicios"
        class="text-base font-bold text-sps-blue hover:text-sps-navy transition-colors py-1"
        >Servicios</a
      >
      <a
        href="/blog"
        class="text-base font-bold text-sps-blue hover:text-sps-navy transition-colors py-1"
        >Blog</a
      >
      <a
        href="/contacto"
        class="text-base font-bold text-sps-blue hover:text-sps-navy transition-colors py-1"
        >Contacto</a
      >
    </nav>

    <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
      <!-- Selector de Idioma Móvil -->
      <div class="flex items-center gap-4">
        <button
          type="button"
          id="btn-lang-es-mobile"
          title="Español (Venezuela)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 p-1 rounded"
        >
          <img
            src="https://flagcdn.com/w20/ve.png"
            alt="Bandera Venezuela"
            class="w-7 h-auto rounded-sm"
          />
        </button>
        <button
          type="button"
          id="btn-lang-en-mobile"
          title="English (USA)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 p-1 rounded"
        >
          <img
            src="https://flagcdn.com/w20/us.png"
            alt="Bandera USA"
            class="w-7 h-auto rounded-sm"
          />
        </button>
      </div>

      <!-- Botón CTA Móvil -->
      <a
        href="/contacto"
        class="bg-sps-blue text-white px-5 py-2.5 rounded-full font-bold text-xs hover:bg-sps-navy transition-all shadow-md uppercase tracking-wider"
      >
        Solicitar evaluación
      </a>
    </div>
  </div>
</header>

<script>
  // @ts-nocheck
  function setupHeader() {
    const btnMobileToggle = document.getElementById('btn-mobile-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    btnMobileToggle?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    const btnEn = document.getElementById('btn-lang-en');
    const btnEs = document.getElementById('btn-lang-es');
    const btnEnMobile = document.getElementById('btn-lang-en-mobile');
    const btnEsMobile = document.getElementById('btn-lang-es-mobile');

    function getCookie(name) {
      const v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
      return v ? v[2] : null;
    }

    function setLanguageCookie(lang) {
      document.cookie = `googtrans=/es/${lang}; path=/`;
      document.cookie = `googtrans=/es/${lang}; domain=` + window.location.hostname + "; path=/";
    }

    function updateFlagStyles() {
      const googtrans = getCookie('googtrans') || '';
      const isEnglish = googtrans.includes('/en') || window.location.pathname.startsWith('/en');

      const activeBtns = isEnglish ? [btnEn, btnEnMobile] : [btnEs, btnEsMobile];
      const inactiveBtns = isEnglish ? [btnEs, btnEsMobile] : [btnEn, btnEnMobile];

      activeBtns.forEach(btn => {
        btn?.classList.add('scale-110', 'opacity-100', 'ring-2', 'ring-sps-blue', 'rounded-sm', 'shadow-md');
        btn?.classList.remove('opacity-40');
      });

      inactiveBtns.forEach(btn => {
        btn?.classList.remove('scale-110', 'opacity-100', 'ring-2', 'ring-sps-blue', 'rounded-sm', 'shadow-md');
        btn?.classList.add('opacity-40');
      });
    }

    [btnEn, btnEnMobile].forEach(btn => {
      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        setLanguageCookie('en');
        window.location.reload();
      });
    });

    [btnEs, btnEsMobile].forEach(btn => {
      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        setLanguageCookie('es');
        if (window.location.pathname.startsWith('/en')) {
          window.location.href = '/';
        } else {
          window.location.reload();
        }
      });
    });

    updateFlagStyles();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
