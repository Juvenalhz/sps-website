---
// src/components/Header.astro
import { getSiteSettings } from "../lib/queries";
import { urlFor } from "../lib/sanity";

interface Props {
  lang?: "es" | "en";
}

const { lang } = Astro.props;
const currentLang =
  lang || (Astro.url.pathname.startsWith("/en") ? "en" : "es");

const pathname = Astro.url.pathname;
const isHomePage =
  pathname === "/" ||
  pathname === "/es" ||
  pathname === "/es/" ||
  pathname === "/en" ||
  pathname === "/en/";

const settings = await getSiteSettings();
const logoUrl = settings?.logo ? urlFor(settings.logo)?.url() : null;
const siteTitle = settings?.siteTitle || "SPS";
---

<header
  id="main-header"
  data-current-lang={currentLang}
  data-is-home={isHomePage ? "true" : "false"}
  class={isHomePage
    ? "fixed top-0 left-0 w-full z-50 transition-all duration-300 ease-in-out bg-gradient-to-b from-black/70 via-black/30 to-transparent border-b-4 border-transparent"
    : "bg-white border-b-4 border-sps-blue shadow-sm sticky top-0 z-50 transition-all duration-300"}
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center h-20 lg:h-22"
  >
    <!-- Logo SPS -->
    <a href="/" class="flex items-center gap-3 h-full py-1.5 shrink-0">
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={siteTitle}
            class="h-full w-auto object-contain max-h-[68px] lg:max-h-[76px] transition-all logo-img"
          />
        ) : (
          <div
            class={`text-3xl font-extrabold tracking-tighter transition-colors logo-text ${
              isHomePage ? "text-white" : "text-sps-blue"
            }`}
          >
            {siteTitle}
          </div>
        )
      }
    </a>

    <!-- Navegación Desktop -->
    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/nosotros"
        class={`nav-link text-sm font-bold transition-colors ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Sobre Nosotros</a
      >
      <a
        href="/servicios"
        class={`nav-link text-sm font-bold transition-colors ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Servicios</a
      >
      <a
        href="/blog"
        class={`nav-link text-sm font-bold transition-colors ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Blog</a
      >
      <a
        href="/contacto"
        class={`nav-link text-sm font-bold transition-colors ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Contacto</a
      >
    </nav>

    <!-- Botones y Banderas Desktop -->
    <div class="hidden md:flex items-center gap-6">
      <!-- Selector de Idioma -->
      <div
        id="lang-divider"
        class={`flex items-center gap-3 border-r-2 pr-6 transition-colors ${
          isHomePage ? "border-white/20" : "border-gray-200"
        }`}
      >
        <button
          type="button"
          id="btn-lang-es"
          title="Español (Venezuela)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 hover:scale-105 cursor-pointer p-0.5 rounded"
        >
          <img
            src="https://flagcdn.com/w20/ve.png"
            alt="Bandera Venezuela"
            class="w-6 h-auto rounded-sm"
          />
        </button>
        <button
          type="button"
          id="btn-lang-en"
          title="English (USA)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 hover:scale-105 cursor-pointer p-0.5 rounded"
        >
          <img
            src="https://flagcdn.com/w20/us.png"
            alt="Bandera USA"
            class="w-6 h-auto rounded-sm"
          />
        </button>
      </div>

      <!-- Botón Call to Action -->
      <a
        id="cta-button"
        href="/contacto"
        class={`px-6 py-2.5 rounded-full font-bold text-sm transition-all shadow-md ${
          isHomePage
            ? "bg-sps-yellow text-sps-navy hover:bg-white"
            : "bg-sps-blue text-white hover:bg-sps-navy"
        }`}
      >
        Solicitar evaluación
      </a>
    </div>

    <!-- Botón Menú Hamburguesa (Móvil) -->
    <button
      type="button"
      id="btn-mobile-toggle"
      class={`md:hidden p-2 rounded-lg transition-colors cursor-pointer ${
        isHomePage
          ? "text-white hover:bg-white/10"
          : "text-sps-blue hover:bg-gray-100"
      }`}
      aria-label="Menú principal"
    >
      <svg
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div
    id="mobile-menu"
    class={`hidden md:hidden px-6 py-6 space-y-5 shadow-xl transition-all ${
      isHomePage
        ? "bg-sps-navy/95 backdrop-blur-md text-white border-t border-white/10"
        : "bg-white border-t border-gray-100 text-sps-blue"
    }`}
  >
    <nav class="flex flex-col space-y-4">
      <a
        href="/nosotros"
        class={`text-base font-bold transition-colors py-1 ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Sobre Nosotros</a
      >
      <a
        href="/servicios"
        class={`text-base font-bold transition-colors py-1 ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Servicios</a
      >
      <a
        href="/blog"
        class={`text-base font-bold transition-colors py-1 ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Blog</a
      >
      <a
        href="/contacto"
        class={`text-base font-bold transition-colors py-1 ${
          isHomePage ? "text-white hover:text-sps-yellow" : "text-sps-blue hover:text-sps-navy"
        }`}
        >Contacto</a
      >
    </nav>

    <div
      class={`pt-4 flex items-center justify-between border-t ${
        isHomePage ? "border-white/10" : "border-gray-100"
      }`}
    >
      <!-- Selector de Idioma Móvil -->
      <div class="flex items-center gap-4">
        <button
          type="button"
          id="btn-lang-es-mobile"
          title="Español (Venezuela)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 p-1 rounded"
        >
          <img
            src="https://flagcdn.com/w20/ve.png"
            alt="Bandera Venezuela"
            class="w-7 h-auto rounded-sm"
          />
        </button>
        <button
          type="button"
          id="btn-lang-en-mobile"
          title="English (USA)"
          class="transition-all duration-200 opacity-40 hover:opacity-100 p-1 rounded"
        >
          <img
            src="https://flagcdn.com/w20/us.png"
            alt="Bandera USA"
            class="w-7 h-auto rounded-sm"
          />
        </button>
      </div>

      <!-- Botón CTA Móvil -->
      <a
        href="/contacto"
        class={`px-5 py-2.5 rounded-full font-bold text-xs transition-all shadow-md uppercase tracking-wider ${
          isHomePage
            ? "bg-sps-yellow text-sps-navy hover:bg-white"
            : "bg-sps-blue text-white hover:bg-sps-navy"
        }`}
      >
        Solicitar evaluación
      </a>
    </div>
  </div>
</header>

<script>
  // @ts-nocheck
  function setupHeader() {
    const header = document.getElementById("main-header");
    if (!header) return;

    const isHome = header.dataset.isHome === "true";
    const navLinks = document.querySelectorAll(".nav-link");
    const ctaButton = document.getElementById("cta-button");
    const mobileToggle = document.getElementById("btn-mobile-toggle");
    const langDivider = document.getElementById("lang-divider");
    const logoText = document.querySelector(".logo-text");
    const mobileMenu = document.getElementById("mobile-menu");

    if (isHome) {
      function updateHeaderOnScroll() {
        const isScrolled = window.scrollY > 20;

        if (isScrolled) {
          // Estado al hacer Scroll en Inicio: Fondo blanco con desenfoque
          header.classList.remove("bg-gradient-to-b", "from-black/70", "via-black/30", "to-transparent", "border-transparent");
          header.classList.add("bg-white/95", "backdrop-blur-md", "border-b-4", "border-sps-blue", "shadow-md");

          navLinks.forEach((link) => {
            link.classList.remove("text-white", "hover:text-sps-yellow");
            link.classList.add("text-sps-blue", "hover:text-sps-navy");
          });

          if (ctaButton) {
            ctaButton.classList.remove("bg-sps-yellow", "text-sps-navy", "hover:bg-white");
            ctaButton.classList.add("bg-sps-blue", "text-white", "hover:bg-sps-navy");
          }

          if (mobileToggle) {
            mobileToggle.classList.remove("text-white", "hover:bg-white/10");
            mobileToggle.classList.add("text-sps-blue", "hover:bg-gray-100");
          }

          if (langDivider) {
            langDivider.classList.remove("border-white/20");
            langDivider.classList.add("border-gray-200");
          }

          if (logoText) {
            logoText.classList.remove("text-white");
            logoText.classList.add("text-sps-blue");
          }
        } else {
          // Estado Inicial en Inicio: Transparente sobre el video
          header.classList.remove("bg-white/95", "backdrop-blur-md", "border-b-4", "border-sps-blue", "shadow-md");
          header.classList.add("bg-gradient-to-b", "from-black/70", "via-black/30", "to-transparent", "border-transparent");

          navLinks.forEach((link) => {
            link.classList.remove("text-sps-blue", "hover:text-sps-navy");
            link.classList.add("text-white", "hover:text-sps-yellow");
          });

          if (ctaButton) {
            ctaButton.classList.remove("bg-sps-blue", "text-white", "hover:bg-sps-navy");
            ctaButton.classList.add("bg-sps-yellow", "text-sps-navy", "hover:bg-white");
          }

          if (mobileToggle) {
            mobileToggle.classList.remove("text-sps-blue", "hover:bg-gray-100");
            mobileToggle.classList.add("text-white", "hover:bg-white/10");
          }

          if (langDivider) {
            langDivider.classList.remove("border-gray-200");
            langDivider.classList.add("border-white/20");
          }

          if (logoText) {
            logoText.classList.remove("text-sps-blue");
            logoText.classList.add("text-white");
          }
        }
      }

      window.addEventListener("scroll", updateHeaderOnScroll, { passive: true });
      updateHeaderOnScroll();
    }

    // Toggle menú móvil
    const btnMobileToggle = document.getElementById("btn-mobile-toggle");
    btnMobileToggle?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
    });

    const btnEn = document.getElementById("btn-lang-en");
    const btnEs = document.getElementById("btn-lang-es");
    const btnEnMobile = document.getElementById("btn-lang-en-mobile");
    const btnEsMobile = document.getElementById("btn-lang-es-mobile");

    function getCookie(name) {
      const v = document.cookie.match("(^|;) ?" + name + "=([^;]*)(;|$)");
      return v ? v[2] : null;
    }

    function setLanguageCookie(lang) {
      document.cookie = `googtrans=/es/${lang}; path=/`;
      document.cookie =
        `googtrans=/es/${lang}; domain=` +
        window.location.hostname +
        "; path=/";
    }

    function updateFlagStyles() {
      const googtrans = getCookie("googtrans") || "";
      const isEnglish =
        googtrans.includes("/en") || window.location.pathname.startsWith("/en");

      const activeBtns = isEnglish
        ? [btnEn, btnEnMobile]
        : [btnEs, btnEsMobile];
      const inactiveBtns = isEnglish
        ? [btnEs, btnEsMobile]
        : [btnEn, btnEnMobile];

      activeBtns.forEach((btn) => {
        btn?.classList.add(
          "scale-110",
          "opacity-100",
          "ring-2",
          "ring-sps-yellow",
          "rounded-sm",
          "shadow-md",
        );
        btn?.classList.remove("opacity-40");
      });

      inactiveBtns.forEach((btn) => {
        btn?.classList.remove(
          "scale-110",
          "opacity-100",
          "ring-2",
          "ring-sps-yellow",
          "ring-sps-blue",
          "rounded-sm",
          "shadow-md",
        );
        btn?.classList.add("opacity-40");
      });
    }

    [btnEn, btnEnMobile].forEach((btn) => {
      btn?.addEventListener("click", (e) => {
        e.preventDefault();
        setLanguageCookie("en");
        window.location.reload();
      });
    });

    [btnEs, btnEsMobile].forEach((btn) => {
      btn?.addEventListener("click", (e) => {
        e.preventDefault();
        setLanguageCookie("es");
        if (window.location.pathname.startsWith("/en")) {
          window.location.href = "/";
        } else {
          window.location.reload();
        }
      });
    });

    updateFlagStyles();
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
