---
// src/components/Estadisticas.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();
const stat1Value = homeData?.stat1Value ?? 20;
const stat1Label = homeData?.stat1Label || 'años de experiencia';
const stat2Value = homeData?.stat2Value ?? 520;
const stat2Label = homeData?.stat2Label || 'trabajadores en todo el país';
const stat3Value = homeData?.stat3Value ?? 200;
const stat3Label = homeData?.stat3Label || 'clientes en nuestra trayectoria';

const sanityCertifications = homeData?.certifications || [];
const fallbackCertifications = [
  { name: 'Certificación FONDONORMA', logoUrl: null, code: 'FONDONORMA', desc: 'Sistema de Gestión de Calidad' },
  { name: 'Certificación ISO 9001:2015', logoUrl: null, code: 'ISO 9001:2015', desc: 'Calidad Certificada Internacional' }
];

interface Certification {
  name?: string;
  logo?: any;
  code?: string;
  desc?: string;
}

const certsList = sanityCertifications.length > 0
  ? sanityCertifications.map((c: Certification) => ({
      name: c.name || 'Certificación',
      logoUrl: c.logo ? urlFor(c.logo)?.url() : null,
      code: c.name || 'Certificación',
      desc: 'Certificación Verificada'
    }))
  : fallbackCertifications;
---

<section class="w-full">
  <!-- Franja Azul con Estadísticas y Animación -->
  <div
    class="w-full bg-gradient-to-r from-blue-600 to-[#041530] text-white py-16"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Grid de 3 columnas divididas por líneas finas translúcidas -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/20 text-center"
      >
        <!-- Stat 1 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target={stat1Value}>0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            {stat1Label}
          </p>
        </div>

        <!-- Stat 2 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target={stat2Value}>0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            {stat2Label}
          </p>
        </div>

        <!-- Stat 3 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target={stat3Value}>0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            {stat3Label}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sección de Certificaciones (Parte blanca inferior) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Divisor con texto en el medio -->
    <div class="flex items-center justify-center mb-16">
      <div class="flex-grow max-w-sm border-t border-gray-200"></div>
      <span
        class="flex-shrink-0 mx-6 text-gray-400 text-xl font-light tracking-wide"
        >Certificaciones</span
      >
      <div class="flex-grow max-w-sm border-t border-gray-200"></div>
    </div>

    <!-- Contenedor de Logos de Certificaciones -->
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-16 md:gap-32 flex-wrap"
    >
      {certsList.map((cert: any) => (
        <div class="flex flex-col items-center">
          {cert.logoUrl ? (
            <img
              src={cert.logoUrl}
              alt={cert.name}
              class="h-28 lg:h-36 object-contain hover:scale-105 transition-transform"
            />
          ) : (
            <div class="flex items-center gap-4 px-6 py-4 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md hover:border-sps-yellow transition-all">
              <div class="w-12 h-12 rounded-xl bg-sps-yellow/15 flex items-center justify-center text-sps-yellow shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              </div>
              <div>
                <p class="font-bold text-sps-blue text-sm sm:text-base">{cert.code || cert.name}</p>
                <p class="text-xs text-slate-500">{cert.desc}</p>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 
  Astro aísla este script automáticamente. 
  Usamos IntersectionObserver para que el conteo inicie cuando el usuario vea la sección.
-->
<script>
  // @ts-nocheck
  function initCounters() {
    const counters = document.querySelectorAll(".counter");
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const counter = entry.target;
            const target = +counter.getAttribute("data-target");
            const duration = 2000; // 2 segundos de animación
            let startTimestamp = null;

            const step = (timestamp) => {
              if (!startTimestamp) startTimestamp = timestamp;
              const progress = Math.min(
                (timestamp - startTimestamp) / duration,
                1,
              );

              // Curva de aceleración (easing out)
              const easeProgress =
                progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);

              counter.innerHTML = Math.floor(easeProgress * target).toString();

              if (progress < 1) {
                window.requestAnimationFrame(step);
              } else {
                counter.innerHTML = target.toString();
              }
            };

            window.requestAnimationFrame(step);
            observer.unobserve(counter);
          }
        });
      },
      {
        threshold: 0.15, // Umbral optimizado para móviles y escritorios
      },
    );

    counters.forEach((counter) => {
      observer.observe(counter);
    });
  }

  // Iniciar en carga inicial y en navegaciones de Astro
  initCounters();
  document.addEventListener("astro:page-load", initCounters);
</script>
