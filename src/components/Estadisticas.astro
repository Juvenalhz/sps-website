---
// src/components/Estadisticas.astro
import { getHomePage } from '../lib/queries';
import { urlFor } from '../lib/sanity';

const homeData = await getHomePage();
const sanityCertifications = homeData?.certifications || [];
const fallbackCertifications = [
  { name: 'Certificación FONDONORMA', logoUrl: '/images/fondonorma.png' },
  { name: 'Certificación ISO 9001:2015', logoUrl: '/images/iso.png' }
];

const certsList = sanityCertifications.length > 0
  ? sanityCertifications.map(c => ({
      name: c.name || 'Certificación',
      logoUrl: c.logo ? urlFor(c.logo)?.url() : null
    })).filter(c => c.logoUrl)
  : fallbackCertifications;
---

<section class="w-full">
  <!-- Franja Azul con Estadísticas y Animación -->
  <!-- Usamos un gradiente desde un azul más vivo hasta el azul marino oscuro de la marca -->
  <div
    class="w-full bg-gradient-to-r from-blue-600 to-[#041530] text-white py-16"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Grid de 3 columnas divididas por líneas finas translúcidas -->
      <div
        class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/20 text-center"
      >
        <!-- Stat 1 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target="20">0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            años de experiencia
          </p>
        </div>

        <!-- Stat 2 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target="520">0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            trabajadores en todo el país
          </p>
        </div>

        <!-- Stat 3 -->
        <div class="py-6 md:py-2 px-4">
          <div
            class="text-5xl sm:text-6xl lg:text-7xl font-light text-sps-yellow mb-2 tracking-tight leading-none"
          >
            +<span class="counter" data-target="200">0</span>
          </div>
          <p
            class="text-sm sm:text-base lg:text-lg font-light text-white/90 tracking-wide"
          >
            clientes en nuestra trayectoria
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sección de Certificaciones (Parte blanca inferior) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <!-- Divisor con texto en el medio -->
    <div class="flex items-center justify-center mb-16">
      <div class="flex-grow max-w-sm border-t border-gray-200"></div>
      <span
        class="flex-shrink-0 mx-6 text-gray-400 text-xl font-light tracking-wide"
        >Certificaciones</span
      >
      <div class="flex-grow max-w-sm border-t border-gray-200"></div>
    </div>

    <!-- Contenedor de Logos de Certificaciones -->
    <div
      class="flex flex-col md:flex-row items-center justify-center gap-16 md:gap-32 flex-wrap"
    >
      {certsList.map((cert) => (
        <div class="flex flex-col items-center">
          <img
            src={cert.logoUrl}
            alt={cert.name}
            class="h-32 lg:h-40 object-contain"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div
            class="hidden border-2 border-dashed border-gray-300 w-48 h-32 items-center justify-center text-center text-gray-300 rounded bg-gray-50"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 
  Astro aísla este script automáticamente. 
  Usamos IntersectionObserver para que el conteo inicie cuando el usuario vea la sección.
-->
<script>
  // @ts-nocheck
  function initCounters() {
    const counters = document.querySelectorAll(".counter");
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const counter = entry.target;
            const target = +counter.getAttribute("data-target");
            const duration = 2000; // 2 segundos de animación
            let startTimestamp = null;

            const step = (timestamp) => {
              if (!startTimestamp) startTimestamp = timestamp;
              const progress = Math.min(
                (timestamp - startTimestamp) / duration,
                1,
              );

              // Curva de aceleración (easing out)
              const easeProgress =
                progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);

              counter.innerHTML = Math.floor(easeProgress * target).toString();

              if (progress < 1) {
                window.requestAnimationFrame(step);
              } else {
                counter.innerHTML = target.toString();
              }
            };

            window.requestAnimationFrame(step);
            observer.unobserve(counter);
          }
        });
      },
      {
        threshold: 0.15, // Umbral optimizado para móviles y escritorios
      },
    );

    counters.forEach((counter) => {
      observer.observe(counter);
    });
  }

  // Iniciar en carga inicial y en navegaciones de Astro
  initCounters();
  document.addEventListener("astro:page-load", initCounters);
</script>
