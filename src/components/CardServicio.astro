---
interface Props {
  title: string;
  description: string;
  slug?: string;
  icon?: string;
  imageUrl?: string;
}

const { title, description, slug = "#", icon, imageUrl } = Astro.props;
const href = slug !== "#" ? `/es/servicios/${slug}` : "#";
---

<a href={href} class="group block bg-white rounded-2xl p-8 shadow-md hover:shadow-xl transition-all border border-gray-100 transform hover:-translate-y-1">
  {imageUrl ? (
    <img src={imageUrl} alt={title} class="w-full h-48 object-cover rounded-xl mb-6" />
  ) : (
    <div class="text-4xl mb-6">{icon || '🛡️'}</div>
  )}
  <h3 class="text-2xl font-bold text-sps-navy group-hover:text-sps-blue transition-colors mb-3">
    {title}
  </h3>
  <p class="text-gray-500 text-sm leading-relaxed mb-6">
    {description}
  </p>
  <span class="inline-flex items-center gap-2 text-sm font-bold text-sps-blue group-hover:text-sps-navy transition-colors">
    Ver detalles &rarr;
  </span>
</a>
