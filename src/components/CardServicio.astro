---
interface Props {
  title: string;
  description: string;
  slug?: string;
  icon?: string;
  imageUrl?: string;
  showLink?: boolean;
}

const { title, description, icon, imageUrl, showLink = false } = Astro.props;
---

<div class="bg-white rounded-2xl p-8 shadow-md hover:shadow-lg transition-all border border-gray-100 flex flex-col justify-between">
  <div>
    {imageUrl ? (
      <img src={imageUrl} alt={title} class="w-full h-48 object-cover rounded-xl mb-6" />
    ) : (
      <div class="text-4xl mb-6">{icon || '🛡️'}</div>
    )}
    <h3 class="text-2xl font-bold text-sps-navy mb-3 font-oswald uppercase tracking-tight">
      {title}
    </h3>
    <p class="text-gray-600 text-sm leading-relaxed">
      {description}
    </p>
  </div>
</div>

