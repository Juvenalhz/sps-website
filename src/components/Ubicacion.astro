---
// src/components/Ubicacion.astro
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24 overflow-hidden">
  
  <div class="relative w-full flex flex-col lg:block">
    
    <!-- Imagen del Mapa 3D (Fondo principal) -->
    <!-- En desktop lo alineamos a la derecha para dejar espacio al texto -->
    <div class="w-full lg:w-4/5 lg:ml-auto relative z-0 mb-8 lg:mb-0">
      <img 
        src="/images/mapa-venezuela.png" 
        alt="Mapa 3D de sedes en Venezuela" 
        class="w-full h-auto object-contain"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      
      <!-- Placeholder de respaldo -->
      <div class="hidden w-full h-[350px] sm:h-[500px] border-2 border-dashed border-gray-300 flex-col items-center justify-center text-center text-gray-500 bg-gray-50 rounded-[40px]">
        <span class="text-4xl mb-4">🗺️</span>
        <p class="font-bold text-lg">Mapa 3D (PNG sin fondo)</p>
        <p class="text-sm mt-2">Sube la imagen de tu mapa como:<br/>public/images/mapa-venezuela.png</p>
      </div>
    </div>

    <!-- Texto y Botón (Sobrepuesto en Desktop, abajo en Mobile) -->
    <!-- En desktop se posiciona absolutamente en la esquina inferior izquierda -->
    <div class="w-full lg:absolute lg:bottom-12 lg:left-0 lg:w-1/3 z-10">
      <h2 class="text-4xl lg:text-[54px] font-oswald font-bold text-gray-800 uppercase tracking-tight leading-[1.05] mb-8">
        ESTAMOS DONDE <br class="hidden lg:block" /> NOS NECESITES
      </h2>
      
      <a 
        href="/contacto" 
        class="inline-block bg-sps-yellow text-white px-8 py-3 rounded-full font-bold hover:bg-yellow-500 transition-colors shadow-md text-[15px]"
      >
        Solicitar evaluación
      </a>
    </div>

  </div>

</section>
