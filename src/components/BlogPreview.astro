---
// src/components/BlogPreview.astro
import { getPosts } from '../lib/queries';
import { urlFor } from '../lib/sanity';

// 1. Consultar posts de Sanity
const sanityPosts = await getPosts(4);

// 2. Mock posts como fallback si Sanity no devuelve artículos aún
const fallbackPosts = [
  {
    _id: '1',
    title: 'Análisis de Riesgos Corporativos 2026',
    excerpt: 'Estrategias clave para la evaluación y mitigación de amenazas físicas y digitales en instalaciones.',
    imageUrl: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=800'
  },
  {
    _id: '2',
    title: 'Tendencias en Videovigilancia e IA',
    excerpt: 'Cómo los algoritmos de detección temprana transforman la respuesta ante incidentes.',
    imageUrl: 'https://images.unsplash.com/photo-1557597774-9d273605dfa9?auto=format&fit=crop&q=80&w=800'
  },
  {
    _id: '3',
    title: 'Protocolos de Seguridad Ejecutiva VIP',
    excerpt: 'Mejores prácticas internacionales en movilidad segura y protección de altos directivos.',
    imageUrl: 'https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&q=80&w=800'
  },
  {
    _id: '4',
    title: 'Ciberseguridad en Sistemas Físicos Integrados',
    excerpt: 'Protección de redes de control de acceso y monitoreo frente a vulnerabilidades externas.',
    imageUrl: 'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&q=80&w=800'
  }
];

// Si Sanity trae publicaciones reales, las adaptamos; si no, usamos los de prueba
const posts = (sanityPosts && sanityPosts.length > 0)
  ? sanityPosts.map((p: any) => ({
      _id: p._id,
      title: p.title,
      slug: p.slug?.current || '#',
      excerpt: p.excerpt || 'Sin resumen disponible.',
      imageUrl: p.mainImage ? urlFor(p.mainImage)?.width(800).height(500).url() : 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=800'
    }))
  : fallbackPosts;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
  
  <!-- Encabezado de la sección -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16 items-end">
    
    <!-- Lado Izquierdo (Títulos) -->
    <div>
      <p class="text-sps-blue text-lg lg:text-xl font-medium mb-1">Insights y análisis:</p>
      <h2 class="text-4xl lg:text-5xl font-oswald font-bold text-sps-blue uppercase tracking-tight leading-none">
        SEGURIDAD HOY
      </h2>
    </div>
    
    <!-- Lado Derecho (Texto y Enlace) -->
    <div class="lg:pl-8">
      <p class="text-gray-500 text-[14px] lg:text-[15px] mb-4">
        Mantente informado con nuestros análisis, comunicados oficiales e informes especializados sobre protección corporativa y tendencias tecnológicas.
      </p>
      <a href="/blog" class="inline-flex items-center gap-2 text-sps-blue font-medium hover:text-sps-navy transition-colors text-sm group">
        <span class="w-6 h-6 bg-sps-blue text-white flex items-center justify-center transition-colors group-hover:bg-sps-navy">
          <!-- SVG Flecha -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </span>
        Más información
      </a>
    </div>
  </div>

  <!-- Grid de Artículos (2x2) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
    
    {posts.map((post: any) => (
      <a href={post.slug && post.slug !== '#' ? `/es/blog/${post.slug}` : '#'} class="group block cursor-pointer flex flex-col">
        <article class="flex flex-col h-full">
          <!-- Imagen -->
          <div class="w-full h-[250px] sm:h-[300px] lg:h-[320px] mb-6 overflow-hidden bg-gray-100 rounded-lg">
            <img 
              src={post.imageUrl} 
              alt={post.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          
          <!-- Contenido (con línea azul a la izquierda) -->
          <div class="border-l-2 border-sps-blue/30 group-hover:border-sps-blue transition-colors pl-4 mt-auto">
            <h3 class="font-bold text-xl text-gray-800 mb-2 group-hover:text-sps-blue transition-colors">
              {post.title}
            </h3>
            <p class="text-gray-500 text-[14px] leading-relaxed">
              {post.excerpt}
            </p>
          </div>
        </article>
      </a>
    ))}
    
  </div>

</section>
