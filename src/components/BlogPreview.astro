---
// src/components/BlogPreview.astro
import { getPosts } from '../lib/queries';
import { urlFor, getPostExcerpt } from '../lib/sanity';

// 1. Consultar los 2 artículos más recientes de Sanity
const sanityPosts = await getPosts(2);

// 2. Mock posts como fallback si Sanity no devuelve artículos aún
const fallbackPosts = [
  {
    _id: '1',
    title: 'Análisis de Riesgos Corporativos 2026',
    excerpt: 'Estrategias clave para la evaluación y mitigación de amenazas físicas y digitales en instalaciones.',
    imageUrl: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=800',
    slug: 'analisis-de-riesgos-corporativos'
  },
  {
    _id: '2',
    title: 'Tendencias en Videovigilancia e IA',
    excerpt: 'Cómo los algoritmos de detección temprana transforman la respuesta ante incidentes.',
    imageUrl: 'https://images.unsplash.com/photo-1557597774-9d273605dfa9?auto=format&fit=crop&q=80&w=800',
    slug: 'tendencias-en-videovigilancia'
  }
];

// Si Sanity trae publicaciones reales, usamos las 2 más recientes
const posts = (sanityPosts && sanityPosts.length > 0)
  ? sanityPosts.map((p: any) => ({
      _id: p._id,
      title: p.title,
      slug: p.slug?.current || '#',
      excerpt: getPostExcerpt(p, 120),
      imageUrl: p.mainImage ? urlFor(p.mainImage)?.width(800).height(500).url() : 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=800'
    }))
  : fallbackPosts;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
  
  <!-- Encabezado de la sección -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-14 items-end">
    
    <!-- Lado Izquierdo (Títulos) -->
    <div>
      <p class="text-sps-blue text-lg lg:text-xl font-medium mb-1">Insights y análisis:</p>
      <h2 class="text-4xl lg:text-5xl font-oswald font-bold text-sps-blue uppercase tracking-tight leading-none">
        SEGURIDAD HOY
      </h2>
    </div>
    
    <!-- Lado Derecho (Texto de introducción) -->
    <div class="lg:pl-8">
      <p class="text-gray-500 text-[14px] lg:text-[15px] leading-relaxed">
        Mantente informado con nuestros análisis, comunicados oficiales e informes especializados sobre protección corporativa y tendencias tecnológicas.
      </p>
    </div>
  </div>

  <!-- Grid de Artículos Recientes (2 columnas) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
    
    {posts.map((post: any) => (
      <a href={post.slug && post.slug !== '#' ? `/es/blog/${post.slug}` : '#'} class="group block cursor-pointer flex flex-col">
        <article class="flex flex-col h-full">
          <!-- Imagen -->
          <div class="w-full h-[260px] sm:h-[320px] mb-6 overflow-hidden bg-gray-100 rounded-2xl shadow-md">
            <img 
              src={post.imageUrl} 
              alt={post.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          
          <!-- Contenido (con línea azul a la izquierda) -->
          <div class="border-l-3 border-sps-blue/40 group-hover:border-sps-blue transition-colors pl-4 mt-auto">
            <h3 class="font-bold text-xl text-gray-800 mb-2 group-hover:text-sps-blue transition-colors leading-snug">
              {post.title}
            </h3>
            <p class="text-gray-500 text-[14px] leading-relaxed">
              {post.excerpt}
            </p>
          </div>
        </article>
      </a>
    ))}
    
  </div>

  <!-- Botón Inferior hacia la página del Blog -->
  <div class="mt-14 text-center">
    <a 
      href="/es/blog" 
      class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-sps-navy hover:bg-sps-blue text-white text-xs sm:text-sm font-bold uppercase tracking-wider transition-all shadow-md hover:shadow-lg cursor-pointer"
    >
      <span>Ver todos los artículos</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>

</section>

