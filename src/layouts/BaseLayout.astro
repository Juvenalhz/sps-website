---
// src/layouts/BaseLayout.astro
import "../styles/global.css"; // Esto conecta Tailwind y tus colores
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | SPS Seguridad</title>
	</head>
	<body
		class="bg-[var(--color-background)] text-[var(--color-text)] font-sans flex flex-col min-h-screen m-0 p-0"
	>
		<Header />

		<main class="flex-grow w-full">
			<slot />
			<!-- Aquí se inyecta el contenido de cada página -->
		</main>

		<Footer />
	</body>
</html>
